# Set default behavior to automatically normalize line endings to LF in git repository
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized to LF
*.py text eol=lf
*.rs text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts requiring CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf

# Denote all binary files that should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyd binary
*.zip binary
*.tar.gz binary
*.7z binary
*.db binary
*.edb binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
