{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusExplorer",
  "version": "0.1.0",
  "identifier": "com.nexusexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NexusExplorer",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*", "$DESKTOP/**/*", "$DOCUMENT/**/*", "$DOWNLOAD/**/*", "$PICTURE/**/*", "$VIDEO/**/*", "$AUDIO/**/*", "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.webp", "**/*.gif", "**/*.bmp", "**/*.svg", "**/*.pdf"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
